<?xml version="1.0"?>
<ruleset name="Case Study Manager">
	<description>WordPress coding standards for Case Study Manager.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<!-- Verbatim Duppins standards. Do not reformat them in this plugin. -->
	<exclude-pattern>*/includes/class-csm-github-updater.php</exclude-pattern>
	<exclude-pattern>*/includes/class-case-study-manager-plugin-info.php</exclude-pattern>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>

	<config name="minimum_supported_wp_version" value="5.8"/>
</ruleset>
